#!/bin/bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
    echo "Usage: ./make_chns_mp4 <benchmark> [fps] [output-file]" >&2
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ffmpeg is required to build MP4 animations." >&2
    exit 1
fi

benchmark="$1"
fps="${2:-12}"
output_file="${3:-output/chns-${benchmark}.mp4}"

mapfile -t frames < <(printf '%s\n' output/chns-"${benchmark}"-t*.png | sort -V)

if [[ ${#frames[@]} -eq 0 || "${frames[0]}" == "output/chns-${benchmark}-t*.png" ]]; then
    echo "No frames found for benchmark '${benchmark}' in output/." >&2
    exit 1
fi

mkdir -p "$(dirname "${output_file}")"

temp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "${temp_dir}"
}
trap cleanup EXIT

for i in "${!frames[@]}"; do
    printf -v frame_name 'frame-%05d.png' "${i}"
    ln -s "$(realpath "${frames[$i]}")" "${temp_dir}/${frame_name}"
done

ffmpeg -y \
    -hide_banner \
    -loglevel error \
    -framerate "${fps}" \
    -i "${temp_dir}/frame-%05d.png" \
    -c:v libx264 \
    -crf 18 \
    -movflags +faststart \
    -pix_fmt yuv420p \
    "${output_file}"

echo "Wrote ${output_file}"
